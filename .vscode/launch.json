{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenCV Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/visual",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "GTK_PATH",
                    "value": ""
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake-build",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}